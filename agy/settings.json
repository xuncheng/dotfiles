{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "altScreenMode": "always",
  "notifications": true,
  "statusLine": {
    "type": "command",
    "command": "~/.gemini/antigravity-cli/statusline.sh"
  },
  "title": {
    "type": "command",
    "command": "~/.gemini/antigravity-cli/title.sh"
  },
  "permissions": {
    "allow": [
      "command(ssh-add -l)"
    ],
    "ask": [
      "command(git push)",
      "command(regex:git -C .+ push)",
      "command(gh pr create)",
      "command(tcb)",
      "command(cloudbase)",
      "command(npx @cloudbase/cli)"
    ],
    "deny": [
      "command(sudo)",
      "command(git rebase)",
      "command(regex:git -C .+ rebase)",
      "command(tcb env delete)",
      "command(cloudbase env delete)",
      "command(tcb api)",
      "command(cloudbase api)",
      "command(tcb secrets)",
      "command(cloudbase secrets)",
      "command(npm run deploy-prod)",
      "command(npm run prod-deploy)"
    ]
  }
}
