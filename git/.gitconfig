[user]
  name = Xuncheng Wang
  email = 1650860+xuncheng@users.noreply.github.com
[push]
  default = current
  autoSetupRemote = true
[color]
  ui = true
[alias]
  aa = add --all
  br = branch
  back = checkout -
  ca = commit --amend
  ci = commit --verbose
  co = checkout
  cob = checkout -b
  di = diff
  dc = diff --cached
  pullff = pull --ff-only
  st = status
  fa = fetch --all
  uncommit = reset --soft HEAD^
  unmerge = reset --hard HEAD
  unstage = reset HEAD
  # Fancy logging.
  #   h  = head
  #   hp = head with patch
  #   r  = recent commits, only current branch
  #   ra = recent commits, all reachable refs
  #   l  = all commits, only current branch
  #   la = all commits, all reachable refs
  head = !git l -1
  h    = !git head
  hp   = "!. ~/.githelpers && show_git_head"
  r    = !git l -30
  ra   = !git r --all
  l    = "!. ~/.githelpers && pretty_git_log"
  la   = !git l --all
[format]
  pretty=format:%C(yellow)%h%Creset -%C(red)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset
[core]
  editor = nvim
  pager = delta
	excludesfile = ~/.gitignore_global
	quotepath = false
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  line-numbers = true
[credential]
  helper = osxkeychain
[commit]
  template = ~/.gitmessage
[diff]
  tool = nvimdiff
[merge]
  tool = nvimdiff
  # Show the common ancestor alongside both sides of a conflict
  conflictStyle = zdiff3
[mergetool]
  keepBackup = true
[github]
  user = xuncheng
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[fetch]
  prune = true
[pull]
	rebase = false
[init]
	defaultBranch = main
[submodule]
	recurse = true
[gpg]
  format = ssh
[user]
  signingkey = ~/.ssh/id_ed25519_signing.pub
[commit]
  gpgsign = true
[tag]
  gpgsign = true
