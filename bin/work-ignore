#!/usr/bin/env python3
"""Generate search-filter files for the projects under $WORK_DIR (idempotent).

Every rule is derived from each project's *.code-workspace; no directory
names are hardcoded:

  1. <project>/.ignore              exclude directories that are not in the
                                    workspace folders (frontend-only repos
                                    such as app / miniprogram)
  2. <folder>/.ignore               where a folder holds both src/ and
                                    functions/, exclude src/ (the mixed
                                    frontend/backend admin repos)
  3. <folder>/.vscode/settings.json as above, adding search.exclude for
                                    VSCode

.ignore is read only by fd, rg and snacks.picker; git ignores it entirely.
Both .vscode and .ignore are in ~/.gitignore_global, so neither can be
committed to a team repository by accident.

Usage: work-ignore [--dry-run]
"""

import json
import os
import re
import sys

MARK = "# generated by work-ignore"
R, G, Y, B, N = "\033[0;31m", "\033[0;32m", "\033[1;33m", "\033[0;34m", "\033[0m"

DRY = "--dry-run" in sys.argv
WORK = os.environ.get("WORK_DIR") or os.path.expanduser("~/code/work")


def write(path, body):
    """Write the file, skipping anything that exists and was not generated
    here, so hand-written content is never overwritten."""
    rel = path.replace(os.path.expanduser("~"), "~")
    if os.path.exists(path) and MARK not in open(path, encoding="utf-8").read():
        print(f"  {Y}跳过{N} {rel}（已存在且非本脚本生成）")
        return
    if os.path.exists(path) and open(path, encoding="utf-8").read() == body:
        return
    if DRY:
        print(f"  {B}将写入{N} {rel}")
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    open(path, "w", encoding="utf-8").write(body)
    print(f"  {G}✓{N} {rel}")


def merge_vscode(path, folder):
    """Merge search.exclude into .vscode/settings.json, keeping what is
    already there."""
    rel = path.replace(os.path.expanduser("~"), "~")
    data, existing = {}, ""
    if os.path.exists(path):
        existing = open(path, encoding="utf-8").read()
        try:
            data = json.loads(re.sub(r"^\s*//.*$", "", existing, flags=re.M))
        except ValueError:
            print(f"  {R}跳过{N} {rel}（JSON 解析失败，请手动处理）")
            return
    if data.get("search.exclude", {}).get("src") is True:
        return
    data.setdefault("search.exclude", {})["src"] = True
    if DRY:
        print(f"  {B}将更新{N} {rel}")
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("// 前端代码不由我维护，从 Ctrl+P 与全局搜索里排除（文件树仍可见）\n")
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    print(f"  {G}✓{N} {rel}" + ("（已合并原有配置）" if existing else ""))


def main():
    if not os.path.isdir(WORK):
        sys.exit(f"{R}找不到 {WORK}{N}，请设置 WORK_DIR")
    print(f"扫描 {WORK}\n")

    for proj in sorted(os.listdir(WORK)):
        d = os.path.join(WORK, proj)
        ws = os.path.join(d, proj + ".code-workspace")
        if not os.path.exists(ws):
            continue
        keep = set(re.findall(r'"path"\s*:\s*"([^"]+)"', open(ws, encoding="utf-8").read()))
        subs = [x for x in sorted(os.listdir(d))
                if os.path.isdir(os.path.join(d, x)) and not x.startswith(".")]
        print(f"{B}▸ {proj}{N}  workspace: {', '.join(sorted(keep)) or '（空）'}")

        # 1. exclude whole directories that are outside the workspace
        drop = [x for x in subs if x not in keep]
        if drop:
            body = (f"{MARK}\n# 不在 {proj}.code-workspace 里的目录：纯前端仓库，不由我维护\n"
                    "# 仅影响从本目录发起的搜索；直接 cd 进这些仓库时不受影响\n")
            body += "".join(x + "/\n" for x in drop)
            write(os.path.join(d, ".ignore"), body)

        # 2+3. mixed frontend/backend folder: exclude src/ only
        for f in sorted(keep):
            fd_ = os.path.join(d, f)
            if not (os.path.isdir(os.path.join(fd_, "src"))
                    and os.path.isdir(os.path.join(fd_, "functions"))):
                continue
            body = (f"{MARK}\n# 前端代码不由我维护，从 fd / rg / snacks.picker 的结果里排除\n"
                    "# git 不读本文件，src/ 仍正常纳入版本控制\nsrc/\n")
            write(os.path.join(fd_, ".ignore"), body)
            merge_vscode(os.path.join(fd_, ".vscode", "settings.json"), f)
        print()

    if DRY:
        print(f"{Y}dry-run，未写入任何文件{N}")


main()
