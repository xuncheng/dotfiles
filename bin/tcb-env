#!/bin/bash
#
# Switch Tencent CloudBase accounts. Secrets live in the macOS login Keychain,
# never in this repo or in shell history.
#
#   tcb-env add <profile>   store an apiKeyId/apiKey pair (prompts for both)
#   tcb-env use <profile>   re-login with that pair and list its environments
#   tcb-env ls              list stored profiles
#   tcb-env rm <profile>    forget a profile

set -euo pipefail

readonly SERVICE_PREFIX="tcb-env:"

die() {
  echo "tcb-env: $*" >&2
  exit 1
}

usage() {
  sed -n '3,10p' "$0" | cut -c 3-
  exit "${1:-1}"
}

service_for() {
  [ -n "${1:-}" ] || die "missing <profile>"
  printf '%s%s' "$SERVICE_PREFIX" "$1"
}

# The apiKeyId is stored as the item's account, the apiKey as its password.
key_id_of() {
  # A missing item is not an error here; cmd_use reports it with a better message.
  { security find-generic-password -s "$1" 2>/dev/null || true; } |
    awk -F'"' '/"acct"<blob>=/ { print $4 }'
}

cmd_add() {
  local service key_id key
  service=$(service_for "${1:-}")
  read -r -p "apiKeyId: " key_id
  [ -n "$key_id" ] || die "apiKeyId must not be empty"
  read -r -s -p "apiKey: " key
  echo
  [ -n "$key" ] || die "apiKey must not be empty"
  # The key is passed as an argument rather than letting `security` prompt for
  # it: security reads its own prompts straight from /dev/tty, so it cannot be
  # fed from here. It is briefly visible in `ps` for this one process, the same
  # exposure `tcb login --apiKey` already has; it stays out of shell history.
  local output
  output=$(security add-generic-password -U \
    -s "$service" \
    -a "$key_id" \
    -l "$service" \
    -D "tcb-env credential" \
    -w "$key" 2>&1) || die "keychain write failed: $output"
  echo "tcb-env: saved ${1}"
}

cmd_use() {
  local service key_id key
  service=$(service_for "${1:-}")
  key_id=$(key_id_of "$service")
  [ -n "$key_id" ] || die "unknown profile '${1}' (try: tcb-env ls)"
  key=$(security find-generic-password -s "$service" -w)

  tcb logout || true
  tcb login --apiKeyId "$key_id" --apiKey "$key"
  tcb env list
}

cmd_ls() {
  security dump-keychain |
    awk -F'"' -v prefix="$SERVICE_PREFIX" '
      $2 == "svce" && index($4, prefix) == 1 { print substr($4, length(prefix) + 1) }
    ' | sort -u
}

cmd_rm() {
  local service
  service=$(service_for "${1:-}")
  security delete-generic-password -s "$service" >/dev/null 2>&1 ||
    die "unknown profile '${1}' (try: tcb-env ls)"
  echo "tcb-env: removed ${1}"
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  use) shift; cmd_use "$@" ;;
  ls | list) cmd_ls ;;
  rm | remove) shift; cmd_rm "$@" ;;
  -h | --help) usage 0 ;;
  "") usage ;;
  *) die "unknown command '$1'" ;;
esac
