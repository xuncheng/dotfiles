#!/bin/bash

# ANSI colour codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color, resets the colour

# The commit message to use
# commit_message="wip"

# The repository list, built from an environment variable
declare -a repos=(
  "${WORK_DIR}/uguzi/admin"
  "${WORK_DIR}/uguzi/backend"
  "${WORK_DIR}/uchiwu-online/admin"
  "${WORK_DIR}/uchiwu-online/backend"
  "${WORK_DIR}/chiwushe/admin"
  "${WORK_DIR}/chiwushe/backend"
)

# Walk each repository
for REPO in "${repos[@]}"; do
  # echo "Processing repository: $REPO"
  echo -e "${ORANGE}==> Processing repository: $REPO${NC}"

  # Skip anything that is not a git repository
  if [ ! -d "$REPO/.git" ]; then
    echo -e "${RED}==> Skipping - Not a Git repository${NC}"
    continue
  fi

  cd "$REPO"
  # Current branch name
  BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

  # Anything uncommitted on this branch?
  CHANGED=$(git status --porcelain)
  if [ -n "$CHANGED" ]; then
      # There are uncommitted changes
      if [ "$BRANCH_NAME" == "main" ] || [ "$BRANCH_NAME" == "master" ]; then
          # On main or master, branch off before committing
          NEW_BRANCH="dev-$(date +%Y%m%d%H%M%S)" # adjust to taste
          git checkout -b "$NEW_BRANCH"
          git add .
          git commit -m "Auto commit on new branch $NEW_BRANCH"
          BRANCH_NAME=$NEW_BRANCH # keep the name for the push below
      else
          # Otherwise commit on the current branch
          git add .
          git commit -m "Auto commit on branch $BRANCH_NAME"
      fi
  fi

  # Push to the remote
  if ! git push origin "$BRANCH_NAME"; then
      echo "${RED}Failed to push changes to the remote branch $BRANCH_NAME of $REPO.${NC}"
  fi

  echo ""

  # Back to the starting directory for the next repository
  cd - > /dev/null
done

echo "All repositories processed."

