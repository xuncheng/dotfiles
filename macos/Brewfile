# Core Unix
brew "git"
brew "curl"
brew "gh"
brew "tmux"
brew "tree"
brew "wget"

# Modern CLI tools
brew "bat"
brew "fd"
brew "fzf"
brew "ripgrep"
brew "git-delta"
brew "git-lfs"
brew "jq"
brew "shellcheck"
brew "terminal-notifier"

# Shell (zsh itself comes from macOS; only the plugins are installed)
brew "zsh-syntax-highlighting"

# Editors: Neovim, plus Vim for the legacy vim/ config
brew "neovim"
brew "vim"
# nvim-treesitter compiles parsers with this; the tree-sitter formula neovim
# itself depends on is the library alone and carries no executable
brew "tree-sitter-cli"

# Language servers and formatters. nvim's LSP config names the binaries and
# attaches to whichever are present, so a missing one is quiet rather than
# broken. One package covers both jsonls and eslint
brew "vscode-langservers-extracted"
brew "marksman"
brew "prettier"
brew "stylua"
# Not from brew: vtsls comes from volta, ruby-lsp and rubocop from the gems,
# so that each follows the toolchain its projects already pin

# Languages / runtimes (Ruby via rbenv; system ruby is EOL 2.6)
brew "rbenv"
brew "ruby-build"
brew "libyaml"
brew "volta"

# Services
brew "redis", restart_service: true

# Fonts
# The cask installs the non-Mono variant too, so postinstall deletes it
cask "font-symbols-only-nerd-font",
     postinstall: "rm -f ~/Library/Fonts/SymbolsNerdFont-Regular.ttf \"$(brew --prefix)\"/Caskroom/font-symbols-only-nerd-font/*/SymbolsNerdFont-Regular.ttf"

# Apps: terminal, launcher and desktop utilities
cask "kitty"
cask "raycast"
cask "easydict"
cask "popclip"
cask "jordanbaird-ice"
cask "menubarx"
cask "1password"
cask "dropbox"

# Apps: GUI editors and dev tools
cask "visual-studio-code"
cask "sublime-text"
cask "macvim"
cask "github"

# Apps: browsers and communication
cask "google-chrome"
cask "wechat"
cask "wechatwork"

# The suite ships as one installer pkg, so Word, Excel and friends all arrive
# from this single cask
cask "microsoft-office"

# cleanshot, keyboard-maestro, runjs and wechatwebdevtools are deliberately
# absent: they have to stay on an old version, which a Brewfile can't express.
# macos/pinned-casks.sh installs those four.
