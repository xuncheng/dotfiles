# Core Unix
brew "git"
brew "curl"
brew "gh"
brew "tmux"
brew "tree"
brew "wget"

# Modern CLI tools
brew "bat"
brew "fd"
brew "fzf"
brew "ripgrep"
brew "git-delta"
brew "git-lfs"
brew "jq"
brew "shellcheck"

# Shell (zsh itself comes from macOS; only the plugins are installed)
brew "zsh-syntax-highlighting"

# Editors: Neovim + LazyVim deps, plus Vim for the legacy vim/ config
brew "neovim"
brew "vim"
brew "stylua"

# Languages / runtimes (Ruby via rbenv; system ruby is EOL 2.6)
brew "rbenv"
brew "ruby-build"
brew "libyaml"

# Services
brew "redis", restart_service: true

# Fonts
# The cask installs the non-Mono variant too, so postinstall deletes it
cask "font-symbols-only-nerd-font",
     postinstall: "rm -f ~/Library/Fonts/SymbolsNerdFont-Regular.ttf \"$(brew --prefix)\"/Caskroom/font-symbols-only-nerd-font/*/SymbolsNerdFont-Regular.ttf"

# Apps
cask "kitty"
cask "easydict"
