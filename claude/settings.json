{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch)",
      "Bash(git branch -a*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(node --version)",
      "Bash(npx tsc*)",
      "Bash(tcb fn list*)",
      "Bash(tcb fn detail*)",
      "Bash(tcb fn log*)",
      "Bash(tcb env list*)",
      "Bash(tcb login --check*)",
      "Bash(tcb fn deploy* --mode test)",
      "Bash(tcb fn deploy* --mode stage)",
      "Bash(tcb fn code update* --mode test)",
      "Bash(tcb fn code update* --mode stage)",
      "Bash(tcb fn config update* --mode test)",
      "Bash(tcb fn config update* --mode stage)",
      "Bash(tcb fn delete* --mode test)",
      "Read(*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(rm *)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(http *)",
      "Bash(https *)",
      "Bash(nc *)"
    ],
    "deny": [
      "Bash(sudo*)",
      "Bash(git rebase*)",
      "Bash(tcb *--mode prod*)",
      "Bash(tcb *--mode=prod*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/cloudbaserc.json)",
      "Read(~/.tcbrc*)",
      "Read(~/.tencent/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/cloudbaserc.json)",
      "Edit(~/.tcbrc*)",
      "Edit(~/.tencent/**)"
    ]
  },
  "model": "opus",
  "tui": "fullscreen",
  "theme": "dark"
}
